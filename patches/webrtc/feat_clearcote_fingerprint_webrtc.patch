 namespace webrtc {
 
+// clearcoat: WebRTC IP mock. Force the server-reflexive ICE candidate IP to a
+// configured value (the proxy egress IP). Set from the renderer side at port
+// allocator creation; read on the network thread during candidate gathering.
+// No-op until SetForcedWebRtcSrflxIP() is called with a parseable IP.
+RTC_EXPORT void SetForcedWebRtcSrflxIP(absl::string_view ip);
+RTC_EXPORT bool HasForcedWebRtcSrflxIP();
+RTC_EXPORT IPAddress ForcedWebRtcSrflxIP();
