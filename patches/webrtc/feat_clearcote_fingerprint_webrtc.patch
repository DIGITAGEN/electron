 #include <cstddef>
 #include <cstdint>
@@ -57,6 +60,34 @@
 #include "rtc_base/weak_ptr.h"
 
 namespace webrtc {
+
+// clearcoat: WebRTC IP mock storage (process-global; one proxy per process).
+namespace {
+Mutex& ClearcoatForcedIpMutex() {
+  static Mutex* m = new Mutex();
+  return *m;
+}
+std::optional<IPAddress>& ClearcoatForcedIpStore() {
+  static std::optional<IPAddress>* ip = new std::optional<IPAddress>();
+  return *ip;
+}
+}  // namespace
+
+void SetForcedWebRtcSrflxIP(absl::string_view ip) {
+  IPAddress parsed;
+  if (IPFromString(ip, &parsed)) {
+    MutexLock lock(&ClearcoatForcedIpMutex());
+    ClearcoatForcedIpStore() = parsed;
+  }
+}
+bool HasForcedWebRtcSrflxIP() {
+  MutexLock lock(&ClearcoatForcedIpMutex());
+  return ClearcoatForcedIpStore().has_value();
+}
+IPAddress ForcedWebRtcSrflxIP() {
+  MutexLock lock(&ClearcoatForcedIpMutex());
+  return ClearcoatForcedIpStore().value_or(IPAddress());
+}
 namespace {
 
 PacketInfoProtocolType ConvertProtocolTypeToPacketInfoProtocolType(
@@ -223,6 +254,13 @@ void Port::AddAddress(const SocketAddress& address,
                       bool is_final) {
   RTC_DCHECK_RUN_ON(thread_);
 
+  // clearcoat: when mocking the WebRTC IP to the proxy egress, never expose a
+  // real local host candidate (it would leak the LAN/real IP). Only the srflx
+  // candidate (rewritten in stun_port.cc) is emitted.
+  if (type == IceCandidateType::kHost && HasForcedWebRtcSrflxIP()) {
+    return;
+  }
