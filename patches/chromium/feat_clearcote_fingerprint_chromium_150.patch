diff --git a/net/ssl/network_persona.cc b/net/ssl/network_persona.cc
new file mode 100644
index 0000000000000..854ae183414bc
--- /dev/null
+++ b/net/ssl/network_persona.cc
@@ -0,0 +1,114 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/ssl/network_persona.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/version_info/version_info.h"
+
+namespace net {
+
+namespace {
+
+// Literal switch name. We intentionally use the string literal rather than
+// depending on //components/ungoogled so this low-level net target stays free
+// of that dependency. Must match `switches::kFingerprintTlsProfile`.
+constexpr char kFingerprintTlsProfileSwitch[] = "fingerprint-tls-profile";
+
+// Post-quantum key-share default-on boundaries in real Chrome:
+//   X25519Kyber768Draft00 (0x6399): default-on ~Chrome 124.
+//   X25519MLKEM768 (0x11EC): switched to the final group ~Chrome 131.
+// So a claimed major in [124, 131) uses Kyber; >= 131 uses ML-KEM;
+// < 124 ships no post-quantum group at all.
+constexpr int kKyberDefaultOnMajor = 124;
+constexpr int kMlkemSwitchMajor = 131;
+
+// ALPS moved to the new codepoint (0x44CD) around the same milestone as the
+// ML-KEM switch; older majors used the old codepoint (0x4469).
+constexpr int kNewAlpsCodepointMajor = 131;
+
+// ECH GREASE has been present since ECH shipped (~Chrome 117), i.e. across the
+// entire modeled range (120..149). It does not vary here, so it is never
+// suppressed in Phase 1 (a boundary of 0 keeps `ech_grease` always true).
+constexpr int kEchGreaseMajor = 0;
+
+// Parses "chrome-<major>" into `major`. Returns true on success. The brand
+// token is header-only and does not change the TLS envelope, but Phase 1 only
+// ever emits "chrome-<major>"; accept exactly that shape here.
+bool ParseChromeMajor(std::string_view value, int* major) {
+  constexpr std::string_view kPrefix = "chrome-";
+  if (value.size() <= kPrefix.size() ||
+      value.substr(0, kPrefix.size()) != kPrefix) {
+    return false;
+  }
+  int parsed = 0;
+  if (!base::StringToInt(value.substr(kPrefix.size()), &parsed) ||
+      parsed <= 0) {
+    return false;
+  }
+  *major = parsed;
+  return true;
+}
+
+}  // namespace
+
+NetworkPersonaPlan ComputeNetworkPersona() {
+  NetworkPersonaPlan plan;
+
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line || !command_line->HasSwitch(kFingerprintTlsProfileSwitch)) {
+    return plan;  // inactive
+  }
+
+  const std::string value =
+      command_line->GetSwitchValueASCII(kFingerprintTlsProfileSwitch);
+
+  // Explicit no-op tokens. `auto` / `match-persona` are resolved SDK-side to a
+  // concrete `chrome-<major>`; if one leaks through to the engine, treat it as
+  // a no-op rather than guessing.
+  if (value.empty() || value == "off" || value == "native" || value == "auto" ||
+      value == "match-persona") {
+    return plan;  // inactive
+  }
+
+  int claimed_major = 0;
+  if (!ParseChromeMajor(value, &claimed_major)) {
+    // Unrecognized value (e.g. a raw-JA3 escape hatch, a Phase 4 concern):
+    // never break the handshake. Fall back to native.
+    return plan;  // inactive
+  }
+
+  // A claimed major equal to this build's own major is a no-op: stock already
+  // emits exactly the right bytes.
+  const int build_major = version_info::GetMajorVersionNumberAsInt();
+  if (claimed_major == build_major) {
+    return plan;  // inactive
+  }
+
+  plan.active = true;
+  plan.major = claimed_major;
+
+  if (claimed_major >= kMlkemSwitchMajor) {
+    // ML-KEM era: same PQ group as this build. No group/key_share delta needed;
+    // the plan is "active" only for the ALPS/ECH deltas (which for >= 131 also
+    // match this build, making the net effect byte-identical to stock).
+    plan.pq = NetworkPersonaPlan::kNative;
+  } else if (claimed_major >= kKyberDefaultOnMajor) {
+    plan.pq = NetworkPersonaPlan::kKyber;
+  } else {
+    plan.pq = NetworkPersonaPlan::kNone;
+  }
+
+  plan.alps_new_codepoint = (claimed_major >= kNewAlpsCodepointMajor);
+  plan.ech_grease = (claimed_major >= kEchGreaseMajor);
+
+  return plan;
+}
+
+}  // namespace net
diff --git a/net/ssl/network_persona.h b/net/ssl/network_persona.h
new file mode 100644
index 0000000000000..5d87d301f44f4
--- /dev/null
+++ b/net/ssl/network_persona.h
@@ -0,0 +1,69 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_SSL_NETWORK_PERSONA_H_
+#define NET_SSL_NETWORK_PERSONA_H_
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// A "network persona" makes the TLS ClientHello's version-variant fields match
+// a claimed Chromium major, instead of the major this build was compiled from.
+// It is driven by the launch switch `--fingerprint-tls-profile=<value>`, read
+// in the network-service process (where net/ssl runs).
+//
+// This is coherence-first, not arbitrary spoofing: it only swaps the fields
+// that genuinely differ between real Chromium majors (the post-quantum
+// key-share group, the ALPS codepoint, ECH GREASE presence). The deterministic
+// envelope (cipher list, version bounds, signature algorithms, ALPN) and the
+// per-connection extension permutation are left exactly as stock Chromium.
+//
+// Value grammar (Phase 1):
+//   "chrome-<major>"     e.g. "chrome-149", "chrome-120" -> version override
+//   absent / "" / "off" / "native" / "auto" / "match-persona" -> NO override
+// A claimed major equal to this build's own Chromium major is also a no-op
+// (byte-identical to stock). `auto` / `match-persona` are resolved SDK-side to
+// a concrete `chrome-<major>`; the engine treats any unrecognized token as a
+// no-op and never breaks the handshake.
+struct NET_EXPORT NetworkPersonaPlan {
+  // How to shape the post-quantum key-share group for the claimed major.
+  enum PqMode {
+    // The claimed major uses the same PQ group as this build (X25519MLKEM768).
+    // No group/key_share override is needed; stock emits the correct bytes.
+    kNative,
+    // The claimed major (~124..130) predates ML-KEM: use X25519Kyber768Draft00.
+    kKyber,
+    // The claimed major (<124) predates default-on PQ: emit no PQ group at all
+    // (classic groups + a classic key_share only).
+    kNone,
+  };
+
+  // True when a concrete, non-native `chrome-<major>` override was requested.
+  // When false, callers MUST leave the stock ClientHello untouched.
+  bool active = false;
+
+  // The claimed Chromium major (only meaningful when `active` is true).
+  int major = 0;
+
+  // The post-quantum shaping to apply (only meaningful when `active` is true).
+  PqMode pq = kNative;
+
+  // Whether the claimed major sends the ALPS extension under the new codepoint
+  // (0x44CD, ~131+) rather than the old one (0x4469, older majors).
+  bool alps_new_codepoint = true;
+
+  // Whether the claimed major emits an ECH GREASE extension (present ~149,
+  // absent in older majors).
+  bool ech_grease = true;
+};
+
+// Computes the network persona plan from the current process command line
+// (`--fingerprint-tls-profile`). Cheap and side-effect free; safe to call once
+// per socket. Returns an inactive plan when no override is requested.
+NET_EXPORT NetworkPersonaPlan ComputeNetworkPersona();
+
+}  // namespace net
+
+#endif  // NET_SSL_NETWORK_PERSONA_H_
diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
new file mode 100644
index 0000000000000..47b09742973bb
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
@@ -0,0 +1,116 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_fingerprint.h"
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/fingerprint_data.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "third_party/blink/renderer/modules/webgl/gpu_info.h"
+
+// GPU deviceID信息可以在这里查询
+// 570.144是驱动号，替换成最新的驱动号
+// https://download.nvidia.com/XFree86/Linux-x86_64/570.144/README/supportedchips.html
+// https://deviceandbrowserinfo.com/data/fingerprints/attribute/webGLRenderer
+// https://devicehunt.com/view/type/pci/vendor/10DE
+
+namespace blink {
+
+using ungoogled::fingerprint::kMacosGpuModelCount;
+
+namespace {
+
+// Returns the appropriate GL_VENDOR string based on platform
+std::string GetGLVendorString(const std::string& platform) {
+  if (platform == "macos") {
+    return "Google Inc. (Apple)";
+  } else if (platform == "linux") {
+    return "Google Inc. (NVIDIA Corporation)";
+  } else {
+    // Windows
+    return "Google Inc. (NVIDIA)";
+  }
+}
+
+// Returns a GL_RENDERER string based on platform and a per-site farbling seed.
+std::string GetGLRendererString(const std::string& platform,
+                                uint64_t effective_seed) {
+  if (platform == "macos") {
+    // Use helper function to get macOS GPU string
+    return GetMacosGpuString(effective_seed % kMacosGpuModelCount);
+  } else if (platform == "linux") {
+    // For Linux, get the basic GPU model but format for Linux
+    size_t model_index = effective_seed % GetGpuCount();
+    // Get the Windows GPU info to extract the model name
+    const GpuInfo& gpu_info = GetGpuInfo(model_index);
+    // Format for Linux (no device ID, different suffix)
+    return GetLinuxGpuString(gpu_info.model_name);
+  } else {
+    // Default to Windows format
+    return GetGpuInfo(effective_seed % GetGpuCount()).renderer_string;
+  }
+}
+
+}  // namespace
+
+// Public functions that will be used in WebGL code
+std::string GetGLVendorStringForFingerprint() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  // 如果禁用GPU指纹，直接返回空字符串
+  if (command_line->HasSwitch(switches::kDisableGpuFingerprint)) {
+    return "";
+  }
+
+  // 优先级1: 如果指定了 fingerprint-gpu-vendor，直接使用
+  if (command_line->HasSwitch(switches::kFingerprintGpuVendor)) {
+    return command_line->GetSwitchValueASCII(switches::kFingerprintGpuVendor);
+  }
+
+  // 优先级2: 如果指定了 fingerprint，根据平台生成
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    std::string platform = "windows";  // Default platform
+    if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+      platform = base::ToLowerASCII(
+          command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+    }
+    return GetGLVendorString(platform);
+  }
+
+  // 优先级3: 都没有指定，返回空字符串（使用默认值）
+  return "";
+}
+
+std::string GetGLRendererStringForFingerprint(uint64_t effective_seed) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  // 如果禁用GPU指纹，直接返回空字符串
+  if (command_line->HasSwitch(switches::kDisableGpuFingerprint)) {
+    return "";
+  }
+
+  // 优先级1: 如果指定了 fingerprint-gpu-renderer，直接使用
+  if (command_line->HasSwitch(switches::kFingerprintGpuRenderer)) {
+    return command_line->GetSwitchValueASCII(switches::kFingerprintGpuRenderer);
+  }
+
+  // 优先级2: 如果指定了 fingerprint，根据平台和 per-site 种子生成。
+  // 种子由调用方按 eTLD+1 计算（ungoogled::GetFarbleSeed64），使得 GPU 型号
+  // 选择按站点稳定但跨站点解相关。
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    std::string platform = "windows";  // Default platform
+
+    if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+      platform = base::ToLowerASCII(
+          command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+    }
+
+    return GetGLRendererString(platform, effective_seed);
+  }
+
+  // 优先级3: 都没有指定，返回空字符串（使用默认值）
+  return "";
+}
+
+}  // namespace blink
