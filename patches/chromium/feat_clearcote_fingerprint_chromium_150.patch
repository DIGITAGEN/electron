+      {"Franklin Gothic Medium", "Arimo"},
+      {"Bahnschrift", "Arimo"},
+      {"Ebrima", "Arimo"},
+      {"Gadugi", "Arimo"},
+      {"Leelawadee UI", "Arimo"},
+      {"Nirmala UI", "Arimo"},
+      {"Lucida Sans Unicode", "Arimo"},
+      {"Segoe UI Emoji", "Arimo"},
