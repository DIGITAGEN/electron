+// Copyright 2026 The Clearcote Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "base/compiler_specific.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <netdb.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+#endif
+
+#include <cstring>
+#include <string_view>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/synchronization/condition_variable.h"
+#include "base/time/time.h"
+#include "components/ungoogled/persona_profile.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "third_party/blink/renderer/platform/canvas_bridge/canvas_bridge_client.h"
+#include "third_party/blink/renderer/platform/canvas_bridge/canvas_bridge_codec.h"
+
+namespace blink::canvas_bridge {
+namespace {
+
+constexpr uintptr_t kInvalidSocket = static_cast<uintptr_t>(-1);
+
+#if BUILDFLAG(IS_WIN)
+void EnsureWinsock() {
+  static const bool started = [] {
+    WSADATA data;
+    return ::WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  }();
+  (void)started;
+}
+#endif
+
+void CloseSocketHandle(uintptr_t s) {
+  if (s == kInvalidSocket) {
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  ::closesocket(static_cast<SOCKET>(s));
+#else
+  ::close(static_cast<int>(s));
+#endif
+}
+
+// Parses "ws://host:port/path" (wss:// accepted but treated as plaintext for
+// now — tunnel via Tailscale/SSH). Returns false on a malformed URL.
+bool ParseUrl(const std::string& url,
+              std::string* host,
+              int* port,
+              std::string* path) {
+  std::string_view v(url);
+  if (v.substr(0, 6) == "wss://") {
+    v.remove_prefix(6);
+  } else if (v.substr(0, 5) == "ws://") {
+    v.remove_prefix(5);
+  } else {
+    return false;
+  }
+  size_t slash = v.find('/');
+  std::string_view authority = v.substr(0, slash);
+  *path = slash == std::string_view::npos ? "/" : std::string(v.substr(slash));
+  size_t colon = authority.find(':');
+  if (colon == std::string_view::npos) {
+    *host = std::string(authority);
+    *port = 80;
+  } else {
+    *host = std::string(authority.substr(0, colon));
+    int p = 0;
+    if (!base::StringToInt(authority.substr(colon + 1), &p) || p <= 0) {
+      return false;
+    }
+    *port = p;
+  }
+  return !host->empty();
+}
+
+}  // namespace
+
+// static
+CanvasBridgeClient* CanvasBridgeClient::Get() {
+  static CanvasBridgeClient* instance = []() -> CanvasBridgeClient* {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd->HasSwitch(switches::kCanvasBridgeUrl)) {
+      return nullptr;
+    }
+    std::string url = cmd->GetSwitchValueASCII(switches::kCanvasBridgeUrl);
+    std::string host, path;
+    int port = 0;
+    if (!ParseUrl(url, &host, &port, &path)) {
+      LOG(ERROR) << "canvas-bridge: malformed --canvas-bridge-url";
+      return nullptr;
+    }
+    std::string auth = cmd->GetSwitchValueASCII(switches::kCanvasBridgeAuth);
+    return new CanvasBridgeClient(std::move(host), port, std::move(path),
+                                  std::move(auth));
+  }();
+  return instance;
+}
+
+CanvasBridgeClient::CanvasBridgeClient(std::string host,
+                                       int port,
+                                       std::string path,
+                                       std::string auth)
+    : host_(std::move(host)),
+      port_(port),
+      path_(std::move(path)),
+      auth_(std::move(auth)) {
+  // Dedicated, detached I/O thread runs connect + read loop for the process
+  // lifetime. The singleton is intentionally leaked, so the thread is never
+  // joined.
+  base::PlatformThread::CreateNonJoinable(0, this);
+}
+
+CanvasBridgeClient::~CanvasBridgeClient() = default;
+
+bool CanvasBridgeClient::Connected() {
+  base::AutoLock lock(state_lock_);
+  return connected_;
+}
+
+uint32_t CanvasBridgeClient::AllocateCanvasId() {
+  base::AutoLock lock(id_lock_);
+  return next_canvas_id_++;
+}
+
+void CanvasBridgeClient::ThreadMain() {
+  base::PlatformThread::SetName("CanvasBridge");
+  if (!Connect()) {
+    LOG(ERROR) << "canvas-bridge: connect failed; rendering stays local";
+    return;
+  }
+  {
+    base::AutoLock lock(state_lock_);
+    connected_ = true;
+  }
+  VLOG(1) << "canvas-bridge: connected to " << host_ << ":" << port_;
+  ReadLoop();
+  {
+    base::AutoLock lock(state_lock_);
+    connected_ = false;
+  }
+}
+
+bool CanvasBridgeClient::Connect() {
+#if BUILDFLAG(IS_WIN)
+  EnsureWinsock();
+#endif
+  addrinfo hints = {};
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* result = nullptr;
+  std::string port_str = base::NumberToString(port_);
+  if (::getaddrinfo(host_.c_str(), port_str.c_str(), &hints, &result) != 0) {
+    return false;
+  }
+
+  uintptr_t sock = kInvalidSocket;
+  for (addrinfo* ai = result; ai; ai = ai->ai_next) {
+    uintptr_t s = static_cast<uintptr_t>(
+        ::socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol));
+    if (s == kInvalidSocket) {
+      continue;
+    }
+    if (::connect(static_cast<
+#if BUILDFLAG(IS_WIN)
+                      SOCKET
+#else
+                      int
+#endif
+                      >(s),
+                  ai->ai_addr, static_cast<int>(ai->ai_addrlen)) == 0) {
+      sock = s;
+      break;
+    }
+    CloseSocketHandle(s);
+  }
+  ::freeaddrinfo(result);
+  if (sock == kInvalidSocket) {
+    return false;
+  }
+  socket_ = sock;
+
+  // RFC 6455 client handshake.
+  uint8_t key_bytes[16];
+  base::RandBytes(key_bytes);
+  std::string key = base::Base64Encode(key_bytes);
+  std::string req =
+      "GET " + path_ + " HTTP/1.1\r\n" + "Host: " + host_ + ":" + port_str +
+      "\r\n" + "Upgrade: websocket\r\n" + "Connection: Upgrade\r\n" +
+      "Sec-WebSocket-Version: 13\r\n" + "Sec-WebSocket-Key: " + key + "\r\n";
+  if (!auth_.empty()) {
+    req += "Authorization: Basic " +
+           base::Base64Encode(base::as_byte_span(auth_)) + "\r\n";
+  }
+  req += "\r\n";
+  if (!WriteExact(req.data(), req.size())) {
+    CloseSocket();
+    return false;
+  }
+
+  std::string resp;
+  char c = 0;
+  while (resp.size() < 8192) {
+    if (!ReadExact(&c, 1)) {
+      CloseSocket();
+      return false;
+    }
+    resp.push_back(c);
+    if (resp.size() >= 4 && resp.compare(resp.size() - 4, 4, "\r\n\r\n") == 0) {
+      break;
+    }
+  }
+  if (resp.find(" 101 ") == std::string::npos) {
+    CloseSocket();
+    return false;
+  }
+
+  HelloMessage hello;
+  hello.persona_seed = ungoogled::CurrentPersona().persona_seed;
+  hello.client_version = "clearcote-canvas-bridge/1";
+  return WriteWebSocketFrame(Encode(hello));
+}
+
+void CanvasBridgeClient::ReadLoop() {
+  std::vector<uint8_t> frame;
+  while (ReadWebSocketFrame(&frame)) {
+    Dispatch(frame);
+  }
+  CloseSocket();
+}
+
+void CanvasBridgeClient::Dispatch(base::span<const uint8_t> frame) {
+  switch (PeekType(frame)) {
+    case MessageType::kImageData: {
+      std::optional<ImageDataMessage> msg = DecodeImageData(frame);
+      if (!msg) {
+        return;
+      }
+      if (msg->content_version == 0) {
+        // Synchronous reply -> the blocking waiter.
+        base::AutoLock lock(pending_lock_);
+        auto it = pending_.find(msg->canvas_id);
+        if (it != pending_.end()) {
+          it->second->pixels = std::move(msg->pixels);
+          it->second->event.Signal();
+        }
+        return;
+      }
+      // Prefetch reply -> the per-canvas cache; coalesce a queued refetch.
+      uint32_t rc = 0, rv = 0, rw = 0, rh = 0;
+      bool do_refetch = false;
+      {
+        base::AutoLock lock(cache_lock_);
+        CachedSurface& c = cache_[msg->canvas_id];
+        if (msg->content_version >= c.have_version) {
+          c.have_version = msg->content_version;
+          c.full_width = msg->width;
+          c.full_height = msg->height;
+          c.pixels = std::move(msg->pixels);
+        }
+        c.inflight_version = 0;
+        if (c.refetch_pending && c.have_version != c.current_version) {
+          c.refetch_pending = false;
+          c.inflight_version = c.current_version;
+          rc = msg->canvas_id;
+          rv = c.current_version;
+          rw = c.full_width;
+          rh = c.full_height;
+          do_refetch = true;
+        }
+        cache_cv_.Broadcast();
+      }
+      if (do_refetch) {
+        SendPrefetchRequest(rc, rv, rw, rh);
+      }
+      return;
+    }
+    case MessageType::kWelcome: {
+      std::optional<WelcomeMessage> msg = DecodeWelcome(frame);
+      if (msg) {
+        VLOG(1) << "canvas-bridge: server gpu=" << msg->gpu_renderer;
+      }
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+std::optional<std::vector<uint8_t>> CanvasBridgeClient::RequestImageData(
+    uint32_t canvas_id,
+    int32_t x,
+    int32_t y,
+    uint32_t width,
+    uint32_t height) {
+  if (!Connected()) {
+    return std::nullopt;
+  }
+
+  PendingReadback pending;
+  {
+    base::AutoLock lock(pending_lock_);
+    pending_[canvas_id] = &pending;
+  }
+
+  GetImageDataMessage req;
+  req.canvas_id = canvas_id;
+  req.x = x;
+  req.y = y;
+  req.width = width;
+  req.height = height;
+  Send(Encode(req));
+
+  pending.event.TimedWait(base::Seconds(5));
+
+  std::optional<std::vector<uint8_t>> result;
+  {
+    base::AutoLock lock(pending_lock_);
+    pending_.erase(canvas_id);
+    result = std::move(pending.pixels);
+  }
+  return result;
+}
+
+std::optional<std::vector<uint8_t>> CanvasBridgeClient::RequestTextMetrics(
+    uint32_t canvas_id,
+    const std::string& text) {
+  if (!Connected()) {
+    return std::nullopt;
+  }
+  PendingReadback pending;
+  {
+    base::AutoLock lock(pending_lock_);
+    pending_[canvas_id] = &pending;
+  }
+  MeasureTextMessage req;
+  req.canvas_id = canvas_id;
+  req.text = text;
+  Send(Encode(req));
+  pending.event.TimedWait(base::Seconds(5));
+  std::optional<std::vector<uint8_t>> result;
+  {
+    base::AutoLock lock(pending_lock_);
+    pending_.erase(canvas_id);
+    result = std::move(pending.pixels);
+  }
+  return result;
+}
+
+void CanvasBridgeClient::EnsurePolicyParsed() {
+  if (policy_parsed_) {
+    return;
+  }
+  policy_parsed_ = true;
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  const std::string mode =
+      cmd->GetSwitchValueASCII(switches::kCanvasBridgeMode);
+  std::string list_switch;
+  if (mode == "off") {
+    policy_mode_ = PolicyMode::kOff;
+  } else if (mode == "allow") {
+    policy_mode_ = PolicyMode::kAllow;
+    list_switch = switches::kCanvasBridgeAllow;
+  } else if (mode == "deny") {
+    policy_mode_ = PolicyMode::kDeny;
+    list_switch = switches::kCanvasBridgeDeny;
+  } else {
+    policy_mode_ = PolicyMode::kAll;  // default ("all" / empty)
+  }
+  if (!list_switch.empty()) {
+    for (const std::string& s :
+         base::SplitString(cmd->GetSwitchValueASCII(list_switch), ",",
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      policy_origins_.insert(s);
+    }
+  }
+  fallback_local_ =
+      cmd->GetSwitchValueASCII(switches::kCanvasBridgeFallback) == "local";
+}
+
+bool CanvasBridgeClient::BridgeEnabledForOrigin(const std::string& etld1) {
+  EnsurePolicyParsed();
+  switch (policy_mode_) {
+    case PolicyMode::kOff:
+      return false;
+    case PolicyMode::kAll:
+      return true;
+    case PolicyMode::kAllow:
+      return policy_origins_.count(etld1) > 0;
+    case PolicyMode::kDeny:
+      return policy_origins_.count(etld1) == 0;
+  }
+  return true;
+}
+
+bool CanvasBridgeClient::FallbackToLocal() {
+  EnsurePolicyParsed();
+  return fallback_local_;
+}
+
+void CanvasBridgeClient::BumpVersion(uint32_t canvas_id) {
+  base::AutoLock lock(cache_lock_);
+  cache_[canvas_id].current_version++;
+}
+
+void CanvasBridgeClient::MaybePrefetch(uint32_t canvas_id,
+                                       uint32_t full_width,
+                                       uint32_t full_height) {
+  if (!Connected()) {
+    return;
+  }
+  uint32_t send_ver = 0;
+  bool do_send = false;
+  {
+    base::AutoLock lock(cache_lock_);
+    CachedSurface& c = cache_[canvas_id];
+    c.full_width = full_width;
+    c.full_height = full_height;
+    if (c.current_version == 0 || c.have_version == c.current_version) {
+      return;  // nothing new to fetch
+    }
+    if (c.inflight_version != 0) {
+      c.refetch_pending = true;  // coalesce
+      return;
+    }
+    c.inflight_version = c.current_version;
+    send_ver = c.current_version;
+    do_send = true;
+  }
+  if (do_send) {
+    SendPrefetchRequest(canvas_id, send_ver, full_width, full_height);
+  }
+}
+
+std::optional<std::vector<uint8_t>> CanvasBridgeClient::TryGetCachedSurface(
+    uint32_t canvas_id,
+    int32_t x,
+    int32_t y,
+    uint32_t width,
+    uint32_t height,
+    bool wait_for_inflight) {
+  base::AutoLock lock(cache_lock_);
+  auto it = cache_.find(canvas_id);
+  if (it == cache_.end()) {
+    return std::nullopt;
+  }
+  CachedSurface& c = it->second;
+  const uint32_t want = c.current_version;
+  if (want == 0) {
+    return std::nullopt;
+  }
+  if (c.have_version != want) {
+    if (!wait_for_inflight || c.inflight_version != want) {
+      return std::nullopt;  // never-block, or not in flight -> caller falls
+                            // back
+    }
+    const base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(5);
+    while (c.have_version != want) {
+      const base::TimeDelta remaining = deadline - base::TimeTicks::Now();
+      if (remaining <= base::TimeDelta()) {
+        return std::nullopt;
+      }
+      cache_cv_.TimedWait(remaining);
+      if (c.current_version != want) {
+        return std::nullopt;  // mutated again while waiting
+      }
+    }
+  }
+  if (x < 0 || y < 0) {
+    return std::nullopt;
+  }
+  const uint64_t fx = static_cast<uint64_t>(x);
+  const uint64_t fy = static_cast<uint64_t>(y);
+  if (fx + width > c.full_width || fy + height > c.full_height) {
+    return std::nullopt;  // out of bounds -> caller falls back
+  }
+  if (c.pixels.size() !=
+      static_cast<size_t>(c.full_width) * c.full_height * 4) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out(static_cast<size_t>(width) * height * 4);
+  const size_t src_stride = static_cast<size_t>(c.full_width) * 4;
+  const size_t dst_stride = static_cast<size_t>(width) * 4;
+  for (uint32_t row = 0; row < height; ++row) {
+    base::span(out)
+        .subspan(row * dst_stride, dst_stride)
+        .copy_from(base::span(c.pixels).subspan(
+            (fy + row) * src_stride + fx * 4, dst_stride));
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> CanvasBridgeClient::GetImageDataCacheFirst(
+    uint32_t canvas_id,
+    int32_t x,
+    int32_t y,
+    uint32_t width,
+    uint32_t height) {
+  const bool never_block = FallbackToLocal();
+  if (auto cached =
+          TryGetCachedSurface(canvas_id, x, y, width, height, !never_block)) {
+    return cached;
+  }
+  if (never_block) {
+    return std::nullopt;  // never-block: cache miss -> caller renders locally
+  }
+  return RequestImageData(canvas_id, x, y, width, height);
+}
+
+void CanvasBridgeClient::SendPrefetchRequest(uint32_t canvas_id,
+                                             uint32_t content_version,
+                                             uint32_t width,
+                                             uint32_t height) {
+  GetImageDataMessage req;
+  req.canvas_id = canvas_id;
+  req.x = 0;
+  req.y = 0;
+  req.width = width;
+  req.height = height;
+  req.content_version = content_version;
+  Send(Encode(req));
+}
+
+bool CanvasBridgeClient::Send(base::span<const uint8_t> frame) {
+  if (!Connected()) {
+    return false;
+  }
+  return WriteWebSocketFrame(frame);
+}
+
+bool CanvasBridgeClient::WriteWebSocketFrame(
+    base::span<const uint8_t> payload) {
+  std::vector<uint8_t> header;
+  header.push_back(0x82);  // FIN + binary opcode.
+  const size_t len = payload.size();
+  if (len < 126) {
+    header.push_back(static_cast<uint8_t>(0x80 | len));
+  } else if (len < 65536) {
+    header.push_back(0x80 | 126);
+    header.push_back(static_cast<uint8_t>((len >> 8) & 0xFF));
+    header.push_back(static_cast<uint8_t>(len & 0xFF));
+  } else {
+    header.push_back(0x80 | 127);
+    for (int i = 7; i >= 0; --i) {
+      header.push_back(static_cast<uint8_t>((len >> (8 * i)) & 0xFF));
+    }
+  }
+  uint8_t mask[4];
+  base::RandBytes(mask);
+  header.insert(header.end(), std::begin(mask), std::end(mask));
+
+  std::vector<uint8_t> masked(payload.begin(), payload.end());
+  for (size_t i = 0; i < masked.size(); ++i) {
+    masked[i] ^= mask[i % 4];
+  }
+
+  base::AutoLock lock(write_lock_);
+  return WriteExact(header.data(), header.size()) &&
+         WriteExact(masked.data(), masked.size());
+}
+
+bool CanvasBridgeClient::ReadWebSocketFrame(std::vector<uint8_t>* out) {
+  for (;;) {
+    uint8_t h[2];
+    if (!ReadExact(h, 2)) {
+      return false;
+    }
+    const uint8_t opcode = h[0] & 0x0F;
+    const bool masked = (h[1] & 0x80) != 0;
+    uint64_t len = h[1] & 0x7F;
+    if (len == 126) {
+      uint8_t e[2];
+      if (!ReadExact(e, 2)) {
+        return false;
+      }
+      len = (uint64_t{e[0]} << 8) | e[1];
+    } else if (len == 127) {
+      uint8_t e[8];
+      if (!ReadExact(e, 8)) {
+        return false;
+      }
+      len = 0;
+      for (int i = 0; i < 8; ++i) {
+        len = (len << 8) | base::span(e)[i];
+      }
+    }
+    uint8_t mask[4] = {0, 0, 0, 0};
+    if (masked && !ReadExact(mask, 4)) {
+      return false;
+    }
+
+    // Bound allocations before accepting a remote frame.
+    if (len > 256 * 1024 * 1024) {
+      return false;
+    }
+    std::vector<uint8_t> payload(len);
+    if (len && !ReadExact(payload.data(), payload.size())) {
+      return false;
+    }
+    if (masked) {
+      for (size_t i = 0; i < payload.size(); ++i) {
+        payload[i] ^= mask[i % 4];
+      }
+    }
+
+    if (opcode == 0x8) {  // close
+      return false;
+    }
+    if (opcode == 0x9 || opcode == 0xA) {  // ping/pong: ignore
+      continue;
+    }
+    *out = std::move(payload);
+    return true;
+  }
+}
+
+bool CanvasBridgeClient::ReadExact(void* buf, size_t n) {
+  // SAFETY: all callers provide a buffer of n bytes.
+  auto bytes = UNSAFE_BUFFERS(base::span(static_cast<uint8_t*>(buf), n));
+  size_t got = 0;
+  while (got < n) {
+#if BUILDFLAG(IS_WIN)
+    int r = ::recv(static_cast<SOCKET>(socket_),
+                   reinterpret_cast<char*>(bytes.subspan(got).data()),
+                   static_cast<int>(n - got), 0);
+#else
+    ssize_t r = ::recv(static_cast<int>(socket_), bytes.subspan(got).data(),
+                       n - got, 0);
+#endif
+    if (r <= 0) {
+      return false;
+    }
+    got += static_cast<size_t>(r);
+  }
+  return true;
+}
+
+bool CanvasBridgeClient::WriteExact(const void* buf, size_t n) {
+  // SAFETY: all callers provide a buffer of n bytes.
+  auto bytes = UNSAFE_BUFFERS(base::span(static_cast<const uint8_t*>(buf), n));
+  size_t sent = 0;
+  while (sent < n) {
+#if BUILDFLAG(IS_WIN)
+    int r = ::send(static_cast<SOCKET>(socket_),
+                   reinterpret_cast<const char*>(bytes.subspan(sent).data()),
+                   static_cast<int>(n - sent), 0);
+#else
+    ssize_t r = ::send(static_cast<int>(socket_), bytes.subspan(sent).data(),
+                       n - sent, 0);
+#endif
+    if (r <= 0) {
+      return false;
+    }
+    sent += static_cast<size_t>(r);
+  }
+  return true;
+}
+
+void CanvasBridgeClient::CloseSocket() {
+  if (socket_ == kInvalidSocket) {
+    return;
+  }
+  CloseSocketHandle(socket_);
+  socket_ = kInvalidSocket;
+}
+
+}  // namespace blink::canvas_bridge
