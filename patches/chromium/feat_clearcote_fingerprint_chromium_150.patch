+// Get Chromium version based on brand and seed
+// Priority:
+// 1. If brand is Chrome with custom version -> return custom version
+// 2. If brand is not Chrome (Edge/Opera/Vivaldi) -> return latest version
+// 3. If has fingerprint seed -> return kChromiumVersions[seed % size]
+// 4. Otherwise -> return first version in array
+std::string GetChromiumVersion() {
+  using namespace ungoogled::fingerprint;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  if (command_line->HasSwitch(switches::kFingerprintBrand)) {
+    std::string brand = base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kFingerprintBrand));
+    // 1. Chrome with custom version
+    if (brand == "chrome" &&
+        command_line->HasSwitch(switches::kFingerprintBrandVersion)) {
+      return command_line->GetSwitchValueASCII(
+          switches::kFingerprintBrandVersion);
+    }
+    // 2. Non-Chrome brand (Edge/Opera/Vivaldi) -> use latest Chromium version
+    if (brand != "chrome" && !brand.empty()) {
+      return kChromiumVersions[0];
+    }
+  }
+
+  // 3. Check if has fingerprint seed
+  if (command_line->HasSwitch(switches::kFingerprint)) {
+    int seed = 0;
+    base::StringToInt(command_line->GetSwitchValueASCII(switches::kFingerprint),
+                      &seed);
+    return kChromiumVersions[seed % std::size(kChromiumVersions)];
+  }
+
+  // 4. Return first version
+  return kChromiumVersions[0];
+}
+
+// Helper to extract major version from full version string
+std::string GetMajorVersion(const std::string& full_version) {
+  size_t pos = full_version.find('.');
+  return pos != std::string::npos ? full_version.substr(0, pos) : full_version;
+}
+
+// Reduce any version string to the Chrome/Edge UA-reduction form:
+// "<major>.0.0.0". Real Chrome/Edge always emit a reduced UA token (e.g.
+// Chrome/149.0.0.0, Edg/149.0.0.0) regardless of the true build number.
+std::string ReducedUAVersion(const std::string& full_version) {
+  return GetMajorVersion(full_version) + ".0.0.0";
+}
+
+// Resolve a brand's full (4-part) version for the Sec-CH-UA-Full-Version-List.
+//   empty              -> the brand's default full build
+//   full "a.b.c.d"     -> used as-is (already a real build)
+//   bare major "149"   -> the default build when its major matches, else
+//   "<major>.0.0.0"
+// The low-entropy Sec-CH-UA hint uses the major of this value; only the
+// full-version-list and the deprecated uaFullVersion carry the full build.
+std::string ResolveFullVersion(const std::string& custom,
+                               const std::string& default_full) {
+  if (custom.empty()) {
+    return default_full;
+  }
+  int dots = 0;
+  for (char c : custom) {
+    if (c == '.') {
+      ++dots;
+    }
+  }
+  if (dots >= 3) {
+    return custom;
+  }
+  if (GetMajorVersion(custom) == GetMajorVersion(default_full)) {
+    return default_full;
+  }
+  return GetMajorVersion(custom) + ".0.0.0";
+}
+
+// 获取平台版本，基于 fingerprint seed 随机化
+std::string GetPlatformVersion(const std::string& platform) {
+  using namespace ungoogled::fingerprint;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  // 自定义版本优先
+  if (command_line->HasSwitch(switches::kFingerprintPlatformVersion)) {
+    return command_line->GetSwitchValueASCII(
+        switches::kFingerprintPlatformVersion);
+  }
+
+  uint64_t seed = ungoogled::CurrentPersona().persona_seed;
+
+  if (platform == "windows") {
+    return kWindowsVersions[seed % std::size(kWindowsVersions)];
+  } else if (platform == "linux") {
+    return kLinuxVersions[seed % std::size(kLinuxVersions)];
+  } else if (platform == "macos") {
+    return kMacOSVersions[seed % std::size(kMacOSVersions)];
+  } else if (platform == "android") {
+    // Atomic with the persona-selected device (all v1 devices are Android 14);
+    // fall back to the shared table default if the persona is unset.
+    const std::string& v = ungoogled::CurrentPersona().android_platform_version;
+    return v.empty() ? kAndroidVersions[0] : v;
+  }
+
+  return "";
+}
+
+void UpdateUserAgentMetadataFingerprint(blink::UserAgentMetadata* metadata) {
+  if (!metadata) {
+    return;
+  }
+
+  const auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch(switches::kFingerprint) &&
+      !cmd->HasSwitch(switches::kFingerprintBrand) &&
+      !cmd->HasSwitch(switches::kFingerprintPlatform)) {
+    return;
+  }
+
+  using namespace ungoogled::fingerprint;
+
+  std::string chromium_version = GetChromiumVersion();
+  std::string chromium_major = GetMajorVersion(chromium_version);
+  int seed = 0;
+  base::StringToInt(chromium_major, &seed);
+
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  // Default: only Chromium (no additional brand)
+  std::optional<std::string> chrome_brand = kChromeDisplayName;
+  std::optional<blink::UserAgentBrandVersion> additional_brand_major =
+      std::nullopt;
+  std::optional<blink::UserAgentBrandVersion> additional_brand_full =
+      std::nullopt;
+
+  if (command_line->HasSwitch(switches::kFingerprintBrand)) {
+    std::string brand_name = base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kFingerprintBrand));
+    std::string custom_version =
+        command_line->HasSwitch(switches::kFingerprintBrandVersion)
+            ? command_line->GetSwitchValueASCII(
+                  switches::kFingerprintBrandVersion)
+            : "";
+
+    if (brand_name == "chrome") {
+      chrome_brand = kChromeDisplayName;
+    } else if (brand_name == "edge") {
+      // Low-entropy Sec-CH-UA uses the major; the full-version-list needs a
+      // full build.
+      std::string edge_full =
+          ResolveFullVersion(custom_version, kEdgeDefaultVersion);
+      additional_brand_major = {kEdgeDisplayName, GetMajorVersion(edge_full)};
+      additional_brand_full = {kEdgeDisplayName, edge_full};
+    } else if (brand_name == "opera") {
+      std::string opera_version =
+          custom_version.empty() ? kOperaDefaultVersion : custom_version;
+      additional_brand_major = {kOperaDisplayName,
+                                GetMajorVersion(opera_version)};
+      additional_brand_full = {kOperaDisplayName, opera_version};
+    } else if (brand_name == "vivaldi") {
+      std::string vivaldi_version =
+          custom_version.empty() ? kVivaldiDefaultVersion : custom_version;
+      additional_brand_major = {kVivaldiDisplayName,
+                                GetMajorVersion(vivaldi_version)};
+      additional_brand_full = {kVivaldiDisplayName, vivaldi_version};
+    }
+  }
+
+  metadata->brand_version_list = GenerateBrandList(
+      seed, chrome_brand, chromium_major, false, additional_brand_major);
+
+  metadata->brand_full_version_list = GenerateBrandList(
+      seed, chrome_brand, chromium_version, true, additional_brand_full);
+
+  if (additional_brand_full.has_value()) {
+    metadata->full_version = additional_brand_full->version;
+  } else {
+    metadata->full_version = chromium_version;
+  }
+
+  // Handle platform information
+  if (command_line->HasSwitch(switches::kFingerprintPlatform)) {
+    std::string platform_value =
+        command_line->GetSwitchValueASCII(switches::kFingerprintPlatform);
+    if (platform_value == "windows") {
+      metadata->platform = kWindowsPlatform;
+      metadata->platform_version = GetPlatformVersion("windows");
+      metadata->architecture = kX86Architecture;
+      metadata->bitness = "64";
+      metadata->wow64 = false;
+      metadata->model = "";
+    } else if (platform_value == "linux") {
+      metadata->platform = kLinuxPlatform;
+      metadata->platform_version = GetPlatformVersion("linux");
+      metadata->architecture = kX86Architecture;
+      metadata->bitness = "64";
+      metadata->wow64 = false;
+      metadata->model = "";
+    } else if (platform_value == "macos") {
+      metadata->platform = kMacOSPlatform;
+      metadata->platform_version = GetPlatformVersion("macos");
+      metadata->architecture = kArmArchitecture;
+      metadata->bitness = "64";
+      metadata->wow64 = false;
+      metadata->model = "";
+    } else if (platform_value == "android") {
+      // clearcote: the SINGLE source for the mobile bit. Setting
+      // metadata->mobile here also flips Sec-CH-UA-Mobile (client_hints.cc) and
+      // navigator.userAgentData.mobile (navigator_ua.cc), which both run
+      // through this override. ARM-Android reports empty architecture + bitness
+      // and a non-empty model; the model is atomic with the WebGL renderer
+      // (same persona device row).
+      metadata->platform = kAndroidPlatform;
+      metadata->platform_version = GetPlatformVersion("android");
+      metadata->architecture = "";
+      metadata->bitness = "";
+      metadata->wow64 = false;
+      const std::string& android_model =
+          ungoogled::CurrentPersona().android_model;
+      metadata->model = android_model.empty() ? "Pixel 7" : android_model;
+      metadata->form_factors = {std::string(blink::kMobileFormFactor)};
+      metadata->mobile = true;
+    }
+  }
+}
+
+std::string GetUserAgentFingerprintBrandInfo() {
+  using namespace ungoogled::fingerprint;
+
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+
+  if (!command_line->HasSwitch(switches::kFingerprintBrand)) {
+    return "";
+  }
+
+  std::string brand = base::ToLowerASCII(
+      command_line->GetSwitchValueASCII(switches::kFingerprintBrand));
+  std::string version =
+      command_line->HasSwitch(switches::kFingerprintBrandVersion)
+          ? command_line->GetSwitchValueASCII(
+                switches::kFingerprintBrandVersion)
+          : "";
+
+  if (brand == "chrome") {
+    return "";
+  } else if (brand == "edge") {
+    return std::string(kEdgeUASuffix) +
+           (version.empty() ? kEdgeUAVersion : ReducedUAVersion(version));
+  } else if (brand == "opera") {
+    return std::string(kOperaUASuffix) +
+           (version.empty() ? kOperaUAVersion : version);
+  } else if (brand == "vivaldi") {
+    return std::string(kVivaldiUASuffix) +
+           (version.empty() ? kVivaldiUAVersion : version);
+  } else if (!brand.empty()) {
+    return " " + brand + "/" + (version.empty() ? brand : version);
+  }
+
+  return "";
+}
+
+std::string GetFingerprintUserAgentVersion(bool reduced) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint) &&
+      !command_line->HasSwitch(switches::kFingerprintBrand) &&
+      !command_line->HasSwitch(switches::kFingerprintBrandVersion)) {
+    return "";
+  }
+  std::string version = GetChromiumVersion();
+  if (version.empty()) {
+    return "";
+  }
+  return reduced ? (GetMajorVersion(version) + ".0.0.0") : version;
+}
+
 }  // namespace blink
