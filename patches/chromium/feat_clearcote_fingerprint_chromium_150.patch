+      {"Cambria", "Caladea"},
+      {"Cambria Math", "Caladea"},
+      {"Constantia", "Caladea"},
+      {"Palatino Linotype", "Caladea"},
+      {"Book Antiqua", "Caladea"},
+      {"Georgia", "Gelasio"},
+      {"Times New Roman", "Tinos"},
+      // --- Windows monospace ---
+      {"Courier New", "Cousine"},
+      {"Consolas", "Inconsolata"},
