+
+// Specify the operating system type
+const char kFingerprintPlatform[] = "fingerprint-platform";
+
+// Specify the operating system version
+const char kFingerprintPlatformVersion[] = "fingerprint-platform-version";
+
+// Specify the location
+const char kFingerprintLocation[] = "fingerprint-location";
+
+// Specify the timezone
+const char kFingerprintTimezone[] = "timezone";
+
+// Disable GPU fingerprint spoofing
+const char kDisableGpuFingerprint[] = "disable-gpu-fingerprint";
+const char kDisableFingerprintNoise[] = "disable-fingerprint-noise";
+const char kFingerprintProfile[] = "fingerprint-profile";
+
+// Specify the TLS network persona (e.g. "chrome-149", "chrome-120"); absent /
+// "off" / "native" leaves the stock ClientHello unchanged. Read in the network
+// service process.
+const char kFingerprintTlsProfile[] = "fingerprint-tls-profile";
+
+// Canvas bridge: forward canvas/WebGL ops to a remote real-GPU render host
+// ("ws://host:port/path"). When unset, rendering stays fully local.
+const char kCanvasBridgeUrl[] = "canvas-bridge-url";
+// Canvas bridge HTTP Basic credentials, "user:secret".
+const char kCanvasBridgeAuth[] = "canvas-bridge-auth";
+// Per-origin policy: off | all (default) | allow | deny.
+const char kCanvasBridgeMode[] = "canvas-bridge-mode";
+// Comma-separated eTLD+1 list for mode=allow / mode=deny.
+const char kCanvasBridgeAllow[] = "canvas-bridge-allow";
+const char kCanvasBridgeDeny[] = "canvas-bridge-deny";
+// Cold cache-miss behavior: block (default) | local (never stall; render
+// local).
+const char kCanvasBridgeFallback[] = "canvas-bridge-fallback";
+
+void CopyFingerprintSwitches(const base::CommandLine& source,
+                             base::CommandLine* target) {
+  static constexpr const char* kSwitches[] = {
+      kFingerprintingClientRectsNoise,
+      kFingerprintingCanvasMeasureTextNoise,
+      kFingerprintingCanvasImageDataNoise,
+      kFingerprint,
+      kFingerprintBrand,
+      kFingerprintBrandVersion,
+      kFingerprintGpuVendor,
+      kFingerprintGpuRenderer,
+      kFingerprintHardwareConcurrency,
+      kFingerprintDeviceMemory,
+      kFingerprintScreenWidth,
+      kFingerprintScreenHeight,
+      kFingerprintAvailWidth,
+      kFingerprintAvailHeight,
+      kFingerprintColorDepth,
+      kFingerprintDevicePixelRatio,
+      kFingerprintMaxTouchPoints,
+      kFingerprintPlatform,
+      kFingerprintPlatformVersion,
+      kFingerprintLocation,
+      kFingerprintTimezone,
+      kDisableGpuFingerprint,
+      kDisableFingerprintNoise,
+      kFingerprintProfile,
+      kFingerprintTlsProfile,
+      kCanvasBridgeUrl,
+      kCanvasBridgeAuth,
+      kCanvasBridgeMode,
+      kCanvasBridgeAllow,
+      kCanvasBridgeDeny,
+      kCanvasBridgeFallback,
+      "fingerprint-webgpu-vendor",
+      "fingerprint-webgpu-architecture",
+      "fingerprint-webgpu-device",
+      "fingerprint-webgpu-description",
+      "fingerprint-storage-quota",
+      "webrtc-ip",
+      "accept-lang",
+  };
+  target->CopySwitchesFrom(source, kSwitches);
+}
+
+}  // namespace switches
