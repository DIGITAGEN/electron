+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  auto* cmd = base::CommandLine::ForCurrentProcess();
+  CHECK(!ungoogled::FingerprintingEnabled());
+  CHECK(ungoogled::DerivePersona(42).webgl_real);
+
+  cmd->AppendSwitchASCII(switches::kFingerprint, "profile-alpha");
+  cmd->AppendSwitchASCII(switches::kFingerprintPlatform, "windows");
+  CHECK(ungoogled::FingerprintingEnabled());
+  const auto a = ungoogled::DerivePersona(42);
+  const auto b = ungoogled::DerivePersona(42);
+  const auto c = ungoogled::DerivePersona(43);
+  CHECK_EQ(a.chrome_major_version, 150u);
+  CHECK_EQ(a.chrome_full_version, version_info::GetVersionNumber());
+  CHECK_EQ(a.persona_seed, b.persona_seed);
+  CHECK_NE(a.persona_seed, c.persona_seed);
+  CHECK_EQ(a.hardware_concurrency, b.hardware_concurrency);
+  CHECK_EQ(a.screen_width, b.screen_width);
+  CHECK_EQ(a.webgl_renderer, b.webgl_renderer);
+  CHECK_GT(a.hardware_concurrency, 0u);
+  CHECK_GT(a.device_memory_gb, 0);
+  CHECK_LE(a.avail_screen_height, a.screen_height);
+  CHECK(!a.webgl_real);
+
+  const auto site_seed = ungoogled::GetFarbleSeed64("example.com");
+  CHECK_EQ(site_seed, ungoogled::GetFarbleSeed64("example.com"));
+  CHECK_NE(site_seed, ungoogled::GetFarbleSeed64("example.org"));
+  cmd->AppendSwitchASCII(switches::kFingerprint, "profile-beta");
+  CHECK_NE(site_seed, ungoogled::GetFarbleSeed64("example.com"));
+
+  cmd->AppendSwitchASCII(switches::kFingerprintTlsProfile, "chrome-150");
+  cmd->AppendSwitchASCII("unrelated-private-option", "must-not-propagate");
+  base::CommandLine child(base::CommandLine::NO_PROGRAM);
+  switches::CopyFingerprintSwitches(*cmd, &child);
+  CHECK_EQ(child.GetSwitchValueASCII(switches::kFingerprint), "profile-beta");
+  CHECK_EQ(child.GetSwitchValueASCII(switches::kFingerprintTlsProfile),
+           "chrome-150");
+  CHECK(!child.HasSwitch("unrelated-private-option"));
+
+  cmd->AppendSwitchASCII(switches::kFingerprintProfile, "invalid-base64!");
+  CHECK_EQ(ungoogled::DerivePersona(42).hardware_concurrency,
+           a.hardware_concurrency);
+  std::string compressed;
+  CHECK(compression::GzipCompress(
+      std::string_view(
+          R"({"hardware_concurrency":6,"device_memory":4,"screen":{"width":1440,"height":900,"avail_width":1440,"avail_height":860}})"),
+      &compressed));
+  cmd->AppendSwitchASCII(switches::kFingerprintProfile,
+                         base::Base64Encode(compressed));
+  const auto imported = ungoogled::DerivePersona(42);
+  CHECK_EQ(imported.hardware_concurrency, 6u);
+  CHECK_EQ(imported.device_memory_gb, 4);
+  CHECK_EQ(imported.screen_width, 1440);
+  CHECK_EQ(imported.screen_height, 900);
+
+  cmd->AppendSwitch(switches::kDisableGpuFingerprint);
+  CHECK(ungoogled::DerivePersona(42).webgl_real);
+  cmd->AppendSwitch(switches::kDisableFingerprintNoise);
+  CHECK(!ungoogled::FingerprintNoiseEnabled());
+  std::puts(
+      "Clearcote core: opt-in, Chromium 150, deterministic persona/site seeds, "
+      "child switches, profile import and disable flags PASS");
+  return 0;
+}
diff --git a/components/ungoogled/farble_seed.cc b/components/ungoogled/farble_seed.cc
new file mode 100644
index 0000000000000..1b07d399813fc
--- /dev/null
+++ b/components/ungoogled/farble_seed.cc
@@ -0,0 +1,51 @@
+#include "components/ungoogled/farble_seed.h"
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/hash/hash.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled {
+
+namespace {
+
+uint32_t GlobalSeed() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch(switches::kFingerprint)) {
+    return 0u;
+  }
+  const std::string raw = cmd->GetSwitchValueASCII(switches::kFingerprint);
+  uint64_t parsed = 0;
+  if (base::StringToUint64(raw, &parsed)) {
+    return static_cast<uint32_t>(parsed);
+  }
+  return base::PersistentHash(raw);
+}
+
+}  // namespace
+
+uint64_t GetFarbleSeed64(std::string_view registrable_domain) {
+  const uint32_t global_seed = GlobalSeed();
+  const uint32_t dhash = base::PersistentHash(registrable_domain);
+  const uint32_t high = dhash + global_seed - 1u;
+  const uint32_t low = base::PersistentHash(base::byte_span_from_ref(high));
+  uint64_t seed64 = (static_cast<uint64_t>(high) << 32) ^
+                    static_cast<uint64_t>(low) ^
+                    (static_cast<uint64_t>(global_seed) << 16);
+  return seed64;
+}
+
+std::string GetFarbleSeedString(std::string_view registrable_domain) {
+  return base::NumberToString(GetFarbleSeed64(registrable_domain));
+}
+
+bool FingerprintNoiseEnabled() {
+  static const bool enabled = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    return !(cmd && cmd->HasSwitch(switches::kDisableFingerprintNoise));
+  }();
+  return enabled;
+}
+
+}  // namespace ungoogled
