+// 判断是否为基础字体（不应被处理）
+static bool IsBasicFont(const std::string& font_family) {
+  const std::set<std::string> basic_fonts = {
+      // 系统特殊字体
+      "-webkit-standard", "system-ui",
+
+      // 基础西文字体
+      "Arial", "Courier New", "Courier", "Helvetica", "Helvetica Neue",
+      "Roboto", "Sans", "Times New Roman", "Times",
+
+      // CSS通用字体
+      "cursive", "fantasy", "monospace", "sans-serif", "serif", "math",
+
+      // 系统字体别名
+      "BlinkMacSystemFont"};
+
+  return basic_fonts.count(font_family) > 0;
