+void StaticBitmapImage::ShuffleSubchannelColorData(const void* addr,
+                                                   const SkImageInfo& info,
+                                                   int srcX,
+                                                   int srcY,
+                                                   uint64_t effective_seed) {
+  auto w = info.width() - srcX, h = info.height() - srcY;
+
+  // skip tiny images; info.width()/height() can also be 0
+  if ((w < 8) || (h < 8)) {
+    return;
+  }
+
+  const auto colorType = info.colorType();
+  const size_t fRowBytes = info.minRowBytes();  // stride
+  size_t bpp;
+  switch (colorType) {
+    case kGray_8_SkColorType:
+      bpp = 1;
+      break;
+    case kRGB_565_SkColorType:
+      bpp = 2;
+      break;
+    case kRGBA_8888_SkColorType:
+    case kBGRA_8888_SkColorType:
+      bpp = 4;
+      break;
+    default:
+      return;  // unsupported layout -> leave the pixels untouched
+  }
+
+  // Content-keyed sparse LSB perturbation. The previous implementation flipped
+  // the LSB of <=10 EDGE pixels (deduped one-per-row/col) -- a recognizable
+  // anti-detect signature that also missed proof-of-work canvases. Instead:
+  // hash the FULL pixel buffer, mix it with the per-eTLD+1 farble seed, and
+  // LSB-flip a sparse set of pixels at PRNG-chosen positions spread across the
+  // whole image. Deterministic per (site, content) -> the readback stays STABLE
+  // across reads (a changing canvas hash would itself be a tell), while the
+  // perturbation looks like distributed per-pixel noise rather than an
+  // edge-only pattern. SAFETY: addr and rowBytes describe the validated
+  // SkPixmap backing store.
+  auto pixels = UNSAFE_BUFFERS(base::span(
+      static_cast<uint8_t*>(const_cast<void*>(addr)),
+      static_cast<size_t>(h - 1) * fRowBytes + static_cast<size_t>(w) * bpp));
+
+  // 1) FNV-1a over the visible pixel rows -> 64-bit content hash.
+  uint64_t content = 1469598103934665603ULL;
+  for (int y = 0; y < h; ++y) {
+    auto row = pixels.subspan(static_cast<size_t>(y) * fRowBytes,
+                              static_cast<size_t>(w) * bpp);
+    const size_t row_len = static_cast<size_t>(w) * bpp;
+    for (size_t k = 0; k < row_len; ++k) {
+      content ^= row[k];
+      content *= 1099511628211ULL;
+    }
+  }
+
+  // 2) xorshift64 PRNG seeded from (per-site farble seed XOR content hash).
+  uint64_t state = effective_seed ^ content;
+  if (state == 0) {
+    state = 0x9E3779B97F4A7C15ULL;
+  }
+  auto next = [&state]() -> uint64_t {
+    state ^= state << 13;
+    state ^= state >> 7;
+    state ^= state << 17;
+    return state;
+  };
+
+  // 3) perturb ~0.17% of the pixels (clamped to [24, 512]) at PRNG positions.
+  const long area = static_cast<long>(w) * static_cast<long>(h);
+  int n_perturb = static_cast<int>(area / 600);
+  if (n_perturb < 24) {
+    n_perturb = 24;
+  } else if (n_perturb > 512) {
+    n_perturb = 512;
+  }
+
+  for (int n = 0; n < n_perturb; ++n) {
+    const uint64_t rnd = next();
+    const int x = static_cast<int>(rnd % static_cast<uint64_t>(w));
+    const int y = static_cast<int>((rnd >> 21) % static_cast<uint64_t>(h));
+    const uint64_t bits = rnd >> 42;
+    auto px = pixels.subspan(
+        static_cast<size_t>(y) * fRowBytes + static_cast<size_t>(x) * bpp, bpp);
+    if (bpp == 4) {
+      // bytes 0..2 are the colour channels (R,G,B or B,G,R); byte 3 is alpha in
+      // both -> leave it.
+      px[0] ^= static_cast<uint8_t>(bits & 1u);
+      px[1] ^= static_cast<uint8_t>((bits >> 1) & 1u);
+      px[2] ^= static_cast<uint8_t>((bits >> 2) & 1u);
+    } else if (bpp == 2) {
+      px[0] ^= static_cast<uint8_t>(bits & 1u);  // LSB of the RGB_565 word
+    } else {
+      px[0] ^= static_cast<uint8_t>(bits & 1u);  // gray
+    }
+  }
